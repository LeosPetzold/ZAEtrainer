<?xml version="1.0" encoding="UTF-8"?>
<schematic>
  <task>
    <variant id="1">Jaký je úbytek napětí na resistoru R<sub>1</sub>?</variant>
    <variant id="2">Jaký je odpor resistoru R<sub>1</sub>?</variant>
  </task>
  <tiles offX="0" offY="0">
    <tile type="half-wire" x="-1" y="-2" rotation="0" />
    <tile type="half-wire" x="-1" y="-2" rotation="90" />

    <tile type="half-wire" x="0" y="-2" rotation="180" />
    <tile type="half-wire" x="0" y="-2" rotation="90" />


    <tile type="wire" x="-1" y="-1" rotation="90" />

    <tile type="resistor" id="R 1" x="0" y="-1" rotation="90" >
      <variant id="1" resistance="rand;1;5;0" />
      <variant id="2" voltage="rand;1;5;0" />
    </tile>

    <tile type="voltage-source" id="U" x="-1" y="0" rotation="0" voltage="rand;1;2;1"/>

    <tile type="half-wire" x="0" y="0" rotation="270" />
