    <tile type="wire" x="-1" y="1" rotation="90" />

    <tile type="resistor" id="R 2" x="0" y="1" rotation="90" resistance="rand;1;5;0"/>
    
    <tile type="resistor" id="R Z" x="1" y="1" rotation="90" resistance="rand;1;5;0"/>

    <tile type="half-wire" x="-1" y="2" rotation="0" />
    <tile type="half-wire" x="-1" y="2" rotation="270" />

    <tile type="half-wire" x="0" y="2" rotation="180" />
    <tile type="half-wire" x="0" y="2" rotation="0" />
    <tile type="half-wire" x="0" y="2" rotation="270" />
    <tile type="dot" x="0" y="2" />

    <tile type="half-wire" x="1" y="2" rotation="180" />
    <tile type="half-wire" x="1" y="2" rotation="270" />
  </tiles>
  <methods>
    <method name="Ohmův zákon a Kirchhoffovy zákony"><![CDATA[
      `Jelikož U<sub>R<sub>z</sub></sub>=${window.circuit.U}V, bla bla bla...
      
      @1Toto jest var1!@@2Toto jest var2!@
      
