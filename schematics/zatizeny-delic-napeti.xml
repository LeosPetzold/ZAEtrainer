      Kombinace resistorů:
      ${(window.circuit.R2 * window.circuit.RZ) / (window.circuit.R2 + window.circuit.RZ)}
      @

      ${window.circuit.U}
      ${window.circuit.R2}
      ${window.circuit.RZ}`
    ]]></method>
    <method name="Theveninův theorém"><![CDATA[
