<?xml version="1.0" encoding="UTF-8"?>
<schematic>
  <tiles>
    <!-- Voltage Divider Circuit -->
    
    <!-- Top rail: voltage source and two resistors in series -->
    <tile type="voltage-source" id="V1" x="0" y="0" rotation="0" name="V1"/>
    <tile type="resistor" id="R1" x="1" y="0" rotation="0" name="R1"/>
    <tile type="resistor" id="R2" x="2" y="0" rotation="0" name="R2"/>
    
    <!-- Right corner: turn down -->
    <tile type="half-wire" id="HW1" x="3" y="0" rotation="90"/>
    <tile type="half-wire" id="HW2" x="3" y="0" rotation="0"/>
    <tile type="terminal" id="J1" x="3" y="0" rotation="0"/>
    
    <!-- Right side: vertical wire down -->
    <tile type="wire" id="W1" x="3" y="1" rotation="90"/>
    
    <!-- Bottom right corner: turn left -->
    <tile type="half-wire" id="HW3" x="3" y="1" rotation="180"/>
    <tile type="half-wire" id="HW4" x="3" y="1" rotation="270"/>
    
    <!-- Bottom rail: return path -->
    <tile type="wire" id="W2" x="2" y="1" rotation="0"/>
    <tile type="dot" id="Tap" x="2" y="1" rotation="0"/>
    <tile type="wire" id="W3" x="1" y="1" rotation="0"/>
    
    <!-- Left side: turn up -->
    <tile type="half-wire" id="HW5" x="0" y="1" rotation="270"/>
    <tile type="half-wire" id="HW6" x="0" y="1" rotation="0"/>
    
  </tiles>
</schematic>